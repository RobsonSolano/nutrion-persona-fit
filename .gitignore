# supabase CLI cache local
supabase/.temp/

# firebase service account (privado — só upload via eas credentials)
*firebase-adminsdk*.json
firebase-service-account.json
.superpowers/

# backlog local de melhorias (rascunho pessoal, fora do git)
BACKLOG.md

# documentos-fonte de referência (TACO etc) — usados pra gerar migration,
# não fazem parte do build
taco_*.pdf

# artefatos do deno check nas edge functions
supabase/functions/**/deno.lock
